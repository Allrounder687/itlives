{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenClaw LWP",
  "version": "0.1.0",
  "identifier": "com.openclaw.lwp",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenClaw LWP - Live Wallpaper Player",
        "width": 1480,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 760,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "tray_menu",
        "url": "/tray",
        "width": 380,
        "height": 480,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' asset: https:; img-src 'self' asset: https: blob: data:; media-src 'self' asset: https: blob: http://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://api.redgifs.com https://media.redgifs.com https://*.redgifs.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
